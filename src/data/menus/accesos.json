{
  "formato": "hoja-anestesia-clc/menus-de-clic",
  "pestana": "Accesos vasculares",
  "version": "3.0",
  "fecha": "2026-10-23",
  "autor": "Dr. Alejandro Jankelevich",
  "como_leer": {
    "resumen": "Se anota solo lo que se hizo. Secciones → campos → opciones. Guardar el \"codigo\" de cada opción, no la etiqueta.",
    "version": "\"ped\" = solo versión pediátrica (ocultar en adulto). Sin \"version\" = aparece en ambas.",
    "tipos": "unica = elegir uno · multiple = elegir varios · si_no · numero (con unidad) · hora.",
    "obligatorio": "true = no deja guardar el acceso con ese campo vacío, si el campo está visible. \"obligatorio_si\" = obligatorio solo con esa condición.",
    "mostrar_si": "{\"campo\", \"op\", \"valor\"}; op: eq (igual), neq (distinto), es_verdadero.",
    "grupos": "Si un campo trae \"grupos\", mostrar las opciones en filas por subgrupo, en ese orden y con su título; cada opción indica su \"grupo\".",
    "equivale_a": "Accesos_Vasculares_Hoja_Anestesia_CLC.docx (misma numeración)."
  },
  "pantalla": "Al elegir el tipo de acceso se muestran de una, en la misma pantalla, los campos de la sección 2 y los de la sección del tipo, sin pasos. Los campos con \"mostrar_si\" aparecen ahí mismo cuando corresponde.",
  "tarjeta": {
    "flujo": "Cada acceso es una tarjeta con hora.",
    "editable": "Se toca la tarjeta y se puede cambiar cualquier campo, incluida la hora; guardar registro del cambio (quién y cuándo).",
    "botones": [
      "Retirar (marca la hora)",
      "Borrar (anula con motivo; no elimina el dato)"
    ],
    "resumen": "{tipo} {calibre} · {sitio} {lado} · {hora} · {procedencia} · {quien | estado al llegar} · {\"Eco\" si acc.eco} · {intentos} intento(s)",
    "ejemplos": [
      "VVP 18G · Antebrazo izq. · 19:40 · Pabellón · Enfermería · Eco · 1 intento",
      "VVP 20G · Mano der. · 08:00 · Pieza · Flebitis"
    ]
  },
