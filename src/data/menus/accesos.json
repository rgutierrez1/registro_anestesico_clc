{
  "formato": "hoja-anestesia-clc/menus-de-clic",
  "version_formato": "1.0",
  "pestana": "Accesos vasculares",
  "version": "1.0",
  "fecha": "2026-10-23",
  "autor": "Dr. Alejandro Jankelevich",
  "como_leer": {
    "resumen": "Pestaña definida como secciones → campos → opciones. Guardar siempre el \"codigo\" (nunca la etiqueta). Mostrar cada campo solo si se cumple su \"mostrar_si\" y si corresponde a la versión activa (adulto o pediátrica).",
    "equivale_a": "Accesos_Vasculares_Hoja_Anestesia_CLC.docx (misma numeración; donde un campo del Word se divide en dos, el segundo lleva sufijo \"b\" o \"c\").",
    "version": {
      "ambas": "Aparece en adulto y en pediátrica. Es el valor por defecto cuando no se indica \"version\".",
      "ped": "Solo versión pediátrica: ocultar en adulto. Si una sección es \"ped\", todo su contenido también lo es."
    },
    "tipos_de_campo": {
      "unica": "Selección única con chips o botones.",
      "multiple": "Selección múltiple. Las opciones listadas en \"exclusivas\" desmarcan todas las demás (p. ej., \"Ninguna\").",
      "numero": "Número con \"unidad\", \"min\" y \"max\". \"boton_alternativo\" es un botón que reemplaza al número (p. ej., \"No medida\").",
      "si_no": "Interruptor sí/no.",
      "hora": "Hora con botones \"Ahora\" y \"Hora personalizada\".",
      "texto": "Texto libre breve.",
      "checklist": "Lista de \"items\"; cada ítem es sí/no.",
      "calculado": "Lo calcula el sistema (⚡); no se tipea. Ver \"logica\"."
    },
    "obligatorio": "\"obligatorio\": true → si el campo está visible, la hoja no se cierra con él vacío. \"obligatorio_si\" → obligatorio solo cuando se cumple esa condición.",
    "condiciones": {
      "formato": "{\"campo\": \"<id>\", \"op\": \"<operador>\", \"valor\": ...}. Se combinan con {\"todas\": [...]} (Y) o {\"alguna\": [...]} (O). \"mostrar_si_texto\" describe en palabras una condición que depende de otra pestaña.",
      "operadores": {
        "eq": "igual a",
        "neq": "distinto de",
        "in": "está en la lista",
        "not_in": "no está en la lista",
        "contiene": "una selección múltiple incluye el código",
        "contiene_alguna": "una selección múltiple incluye al menos uno de los códigos",
        "gte": "mayor o igual (numérico)",
        "lt": "menor (numérico)",
        "lleno": "tiene valor",
        "es_verdadero": "sí/no = sí",
        "es_falso": "sí/no = no"
      }
    },
    "otras_claves": {
      "ambito": "\"caso\" = una vez por anestesia; \"evento\" = se repite (cada acceso o maniobra) y guarda su hora.",
      "por_defecto": "Valor preseleccionado, visible y editable.",
      "abre": "Campos o secciones que se muestran al elegir esa opción (equivale a la flecha → del Word).",
      "alertas": "Lista de {\"si\", \"nivel\" (roja | amarilla | info | bloqueo), \"mensaje\"}. \"bloqueo\" impide cerrar la hoja o el paso indicado.",
      "sugerencia": "Valor que el sistema propone (tablas o fórmulas); el clínico confirma.",
      "valor": "Valor numérico asociado a una opción, para cálculos."
    },
    "definiciones": {
      "intento": "Cada punción de piel. Redirigir la aguja sin salir de la piel no es un intento nuevo.",
      "exito_primer_intento": "Acceso funcionando con la primera punción (ver calculados).",
      "acceso_venoso_dificil_real": "2 o más intentos fallidos, o necesidad de ecografía u otro operador para lograrlo (ver calculados).",
      "flebitis": "Escala VIP (Visual Infusion Phlebitis) 0–5; VIP ≥2 = flebitis."
    }
  },
  "configuracion": {
    "corte_version_pediatrica": {
      "regla": "edad_anios < 15",
      "nota": "Corte a definir por el equipo; permitir cambiarlo a mano por paciente."
    },
    "datos_del_paciente_que_se_usan": ["edad_anios","edad_meses","peso_kg","talla_cm","sexo"],
    "guardar": "Guardar códigos, no etiquetas. La opción \"otro\" abre texto libre y se guarda código + texto.",
    "borrar": "Anular con motivo, usuario y hora; nunca eliminar el dato (trazabilidad de la ficha clínica).",
    "valores_por_defecto": "Solo donde el campo trae \"por_defecto\". Nunca preseleccionar intentos, escalas, capnografía ni complicaciones.",
    "flujo": "Se mantiene el flujo actual de la app: tipo → campos → \"Agregar ahora\" o \"Agregar a hora personalizada\". Puede haber varios accesos por caso; cada uno es un evento con hora.",
    "extremidades": "Las opciones de sitio, vena o arteria traen \"extremidad\" (superior, inferior, cabeza_cuello). Con el lado (acc.lado) se compara contra acc.extremidad_restringida."
  },
  "ruta_corta": {
    "descripcion": "VVP instalada en pabellón sin problemas: ~9 toques, sin tipear nada (mostrar sitio + lado en un mismo chip, como hoy: \"Mano derecha\").",
