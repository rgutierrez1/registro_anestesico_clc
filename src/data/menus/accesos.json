      "logica": "acc.intentos == 1 AND NOT contiene(acc.complicaciones, no_se_logro)"
    },
    {
      "id": "acc.dificil_real",
      "etiqueta": "Acceso venoso difícil real",
      "aplica_si": "acc.procedencia == pabellon",
      "logica": "acc.intentos >= 3 OR (acc.intentos == 2 AND contiene(acc.complicaciones, no_se_logro)) OR contiene_alguna(acc.rescate, [eco, cambio_operador])"
    },
    {
      "id": "acc.flebitis",
      "etiqueta": "Flebitis al llegar",
      "aplica_si": "acc.procedencia != pabellon",
      "logica": "acc.flebitis_vip.valor >= 2"
